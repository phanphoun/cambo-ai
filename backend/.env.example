GEMINI_API_KEY=your_gemini_api_key_here
APP_NAME=CAMBO AI Assistant
APP_VERSION=0.2.0
DEBUG=True
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Ollama (local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Ollama Cloud (for cloud models via https://ollama.com/api)
# List available: curl https://ollama.com/api/tags -H "Authorization: Bearer ***"
# Get your API key at https://ollama.com/settings/keys
OLLAMA_API_KEY=
OLLAMA_CLOUD_BASE_URL=https://ollama.com
OLLAMA_CLOUD_MODEL=minimax-m3

DEFAULT_PROVIDER=gemini

# --- RAG / embeddings ---
RAG_DIR=./data/rag
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120
RAG_TOP_K=5

# --- Upload limits (MB) ---
MAX_IMAGE_MB=8
MAX_DOCUMENT_MB=25

# --- Rate limiting (requests per IP per minute) ---
RATE_LIMIT_PER_MINUTE=30

# --- Tavily web research ---
TAVILY_API_KEY=your_tavily_api_key_here
TAVILY_SEARCH_DEPTH=basic
TAVILY_MAX_RESULTS=5
