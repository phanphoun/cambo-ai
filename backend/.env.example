APP_NAME=SASTRA AI Assistant
APP_VERSION=1.0.0
DEBUG=True
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# --- PostgreSQL Database ---
# Format: postgresql+asyncpg://<username>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/cambo_ai

# --- AI Providers & API Keys ---
DEFAULT_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here

# Ollama (Local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:latest

# Ollama Cloud / MiniMax
OLLAMA_CLOUD_BASE_URL=http://localhost:11434
OLLAMA_CLOUD_MODEL=minimax-m3:cloud

# Web Research (Tavily)
TAVILY_API_KEY=your_tavily_api_key_here
TAVILY_SEARCH_DEPTH=basic
TAVILY_MAX_RESULTS=5

# --- JWT Authentication (Required) ---
# Generate with: openssl rand -hex 32
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_here


# --- Agent Mode (autonomous coding on a LOCAL project) ---
# ⚠ SECURITY: the agent reads files and executes commands on the machine running
# this backend. Enable it ONLY on a computer you control. Never on a public
# deployment (Render, HF Spaces, a VPS reachable from the internet).
AGENT_ENABLED=false
# Absolute path to the project the agent may read. It cannot escape this root.
AGENT_WORKSPACE_ROOT=
# Max model/tool rounds per run before it stops and summarises.
AGENT_MAX_ROUNDS=24
# Seconds before a command the agent runs is killed.
AGENT_COMMAND_TIMEOUT=90
# Comma-separated executables the agent may run. Empty = safe built-in default
# (test/lint/build/inspect only; no installs, no network, no git mutations).
AGENT_ALLOWED_COMMANDS=
# Require an authenticated admin account for every agent endpoint.
AGENT_REQUIRE_ADMIN=true
